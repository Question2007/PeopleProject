<Window x:Class="PeopleProject.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PeopleProject"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Button x:Name="btnEletkor" Content="Button" HorizontalAlignment="Center" Margin="0,247,0,0" VerticalAlignment="Top" Click="btnEletkor_Click"/>
        <Label x:Name="labelEletkor" Content="Életkor" HorizontalAlignment="Left" Margin="340,50,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="eletkorTextBox" HorizontalAlignment="Center" Margin="0,70,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <Label x:Name="labelMin" Content="Minimum életkor" HorizontalAlignment="Left" Margin="340,109,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="minTextBox" HorizontalAlignment="Center" Margin="0,129,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <Label x:Name="labelMax" Content="Maximum életkor" HorizontalAlignment="Left" Margin="340,179,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="maxTextBox" HorizontalAlignment="Center" Margin="0,199,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        
        <ListBox x:Name="listBoxEletkorok" HorizontalAlignment="Left" Height="100" Margin="10,10,0,0" VerticalAlignment="Top" Width="120"/>

    </Grid>
</Window>
